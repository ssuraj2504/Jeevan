APP_ENV=development
DATABASE_URL=sqlite:///./jeevan.db
BOOKING_ADAPTER=simulated
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_CALL_ATTEMPTS=3

# Set these when switching the voice adapter to LiveKit.
VOICE_ADAPTER=simulated
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_AGENT_NAME=jeevan-provider-caller
JEEVAN_WEBHOOK_SECRET=change-me

# Public portfolio sandbox only; use a unique 32+ character secret in deployment.
PUBLIC_DEMO_MODE=false
DEMO_SESSION_SECRET=
DEMO_MAX_TASKS_PER_SESSION=12
DEMO_MAX_TASKS_TOTAL=5000
